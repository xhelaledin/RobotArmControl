      code = Regex.Replace(code, @\"^\\s*#.*$\", m => Store(m, preprocColor), RegexOptions.Multiline);\r\n\r\n       
      string[] keywords = new string[] {\r\n            \"int\",\"float\",\"double\",\"if\",\"else\",\"for\",\"while\",\"return\",\"class\",\"struct\",\"public\",\"private\",\"protected\",\r\n           
